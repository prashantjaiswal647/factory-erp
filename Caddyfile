munshiai.co.in, www.munshiai.co.in {
    # Forward all API paths directly to FastAPI container port 8000
    handle /api/* {
        reverse_proxy api:8000
    }
    
    # Forward everything else to static web container build files
    handle {
        reverse_proxy web:80
    }
}

api.munshiai.co.in {
    reverse_proxy api:8000
}

n8n.munshiai.co.in {
    reverse_proxy n8n:5678
}

db.munshiai.co.in {
    reverse_proxy adminer:8080
}
