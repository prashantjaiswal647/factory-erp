# Ports Configuration for Local Development
LOCAL_API_PORT_MAP=8000:8000
LOCAL_WEB_PORT_MAP=5173:5173
LOCAL_N8N_PORT_MAP=5678:5678

# Dummy ports for Caddy so it doesn't conflict locally
